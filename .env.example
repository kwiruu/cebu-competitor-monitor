# Copy to .env and fill in. Never commit .env.
# Supabase: use the Session pooler string. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Path to the Google service account key file (keep it outside the repo).
GOOGLE_SERVICE_ACCOUNT_FILE=
# Leave empty to read competitors.csv instead of the sheet.
GOOGLE_SHEET_ID=
N8N_WEBHOOK_URL=
# Shared secret sent as the X-Monitor-Secret header, checked by the n8n webhook.
N8N_WEBHOOK_SECRET=
# Price moves at or above this percent are sent to Telegram at once.
ALERT_THRESHOLD_PCT=10
